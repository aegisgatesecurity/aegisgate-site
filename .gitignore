# ==========================================
# AegisGate Website — Hugo .gitignore
# ==========================================

# Hugo build output (regenerated by `hugo --minify`)
# Netlify builds on their servers; we never commit public/
public/
resources/

# Hugo internal lock files
.hugo_build.lock

# Node modules (if you add any)
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Editor / OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# Sveltia CMS local config overrides
# (admin/config.yml is committed; admin/local-config.js is not)
admin/local-config.js

# Netlify
.netlify/

# Backup files (cheap insurance pattern)
*.v*-backup
*.backup
*.bak
*.md.beta.1-backup
*.md.v3.2.0-backup

# Test artifacts
*.log
hugo_server.log

# Local env overrides
.env
.env.local
